DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/cn_ops
PERSISTENCE_PROVIDER=memory
APP_ENV=local

# X Community Notes provider. Keep fixture mode until one genuine test-mode
# access loop has been verified with an enrolled AI Note Writer account.
X_PROVIDER=fixture
X_AUTH_MODE=auto
ALLOW_LIVE_X_API=false
ALLOW_LIVE_X_WRITE=false
ALLOW_NON_TEST_MODE_WRITE=false

# OAuth 1.0a user context (currently used by the X Community Notes quickstart).
X_API_KEY=
X_API_KEY_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# OAuth 2.0 user context (supported by current endpoint reference pages).
X_BEARER_TOKEN=
X_OAUTH2_CLIENT_ID=
X_OAUTH2_CLIENT_SECRET=
X_OAUTH2_REDIRECT_URI=
X_OAUTH2_REFRESH_TOKEN=
X_OAUTH2_SCOPES="tweet.read users.read offline.access"

# Hard X-side operating limits for a two-month admission run. Configure the
# same or lower spend limits in the X developer console.
MONTHLY_X_API_BUDGET_USD=150
DAILY_X_API_BUDGET_USD=10

ALLOW_LIVE_SEARCH=false
SEARCH_PROVIDER=fixture
BRAVE_SEARCH_API_KEY=
PER_CANDIDATE_SEARCH_BUDGET=8

ALLOW_LIVE_LLM=false
LLM_PROVIDER=fixture
LLM_MODEL=
OPENAI_API_KEY=

REQUIRE_OPERATOR_APPROVAL=true
SECRET_KEY=dev-only-change-me
MIN_NEUTRALITY_SCORE=0.75
MIN_HELPFULNESS_PROBABILITY=0.60
MIN_CLAIM_OPINION_SCORE=0.30
COMMUNITY_NOTES_DATA_USE_PURPOSE=community_notes_ai_note_writing
OPERATIONAL_EVALS_DIRECTLY_NECESSARY=true
TRACK_A_REQUIRES_EXPRESS_CONSENT=true
REQUIRE_BOT_IDENTITY_DISCLOSURE=true
BOT_PROFILE_DISCLOSURE="AI Note Writer bot: proposed notes are generated by an automated system for Community Notes AI note writing."
BOT_RESPONSIBLE_PARTY="Ellen Sun"
USAGE_API_RECONCILIATION_REQUIRED=true
DEVELOPER_CONSOLE_RECONCILIATION_REQUIRED=true
EMERGENCY_STOP_EXTERNAL_WRITES=false
EMERGENCY_STOP_REASON=
APPROVED_MULTIMODAL_WORKFLOW_ENABLED=false
GOVERNANCE_POLICY_VERSION=community-notes14-governance-v1
